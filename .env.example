SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INVESTMENT_RADAR_CRON_SECRET=
# Limite distribuído por usuário; exige a migration de hardening da Fase 6.
AI_DAILY_REQUEST_LIMIT=100
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Agente IA (server only). Cloudflare é o padrão e não há fallback automático.
AI_PROVIDER=cloudflare
AI_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Somente para rollback explícito com AI_PROVIDER=lovable:
LOVABLE_API_KEY=

# Pluggy / Open Finance (server only)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
APP_URL=https://app.example.com
OPEN_FINANCE_ENABLED=true
OPENFINANCE_PROVIDER=pluggy
